{{!
    @template mod_plugnmeet/artifact_details

    Example context (json):
    {
        "can_download": true,
        "download_url": "http://example.com/download",
        "is_analytics": false,
        "can_download_analytics": false,
        "can_download_ai_summary_excel": false,
        "download_excel_url": "http://example.com/excel",
        "download_json_url": "http://example.com/json",
        "is_meeting_summary": true,
        "meeting_summary_content": "<p>Meeting summary</p>",
        "is_ai_session_summary": false,
        "can_delete": true,
        "delete_url": "http://example.com/delete",
        "back_url": "http://example.com/back",
        "details": [
            {"label": "Artifact ID", "value": "artifact123"},
            {"label": "Type", "value": "AI agent session summary"}
        ],
        "ai_summary_notice": ""
    }
}}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">{{#str}}artifact_details, mod_plugnmeet{{/str}}</h3>
    <div class="btn-group">
        {{#can_download}}
            <a href="{{download_url}}" class="btn btn-primary">{{#str}}download, mod_plugnmeet{{/str}}</a>
        {{/can_download}}
        {{#can_download_analytics}}
            <a href="{{download_excel_url}}" class="btn btn-success">{{#str}}download_excel_report, mod_plugnmeet{{/str}}</a>
            <a href="{{download_json_url}}" class="btn btn-info">{{#str}}download_raw_json, mod_plugnmeet{{/str}}</a>
        {{/can_download_analytics}}
        {{#can_download_ai_summary_excel}}
            <a href="{{download_excel_url}}" class="btn btn-success">{{#str}}download_excel_report, mod_plugnmeet{{/str}}</a>
        {{/can_download_ai_summary_excel}}
        {{#can_delete}}
            <a href="{{delete_url}}" class="btn btn-danger" onclick="return confirm('{{#str}}delete_confirm, mod_plugnmeet{{/str}}');">{{#str}}delete, mod_plugnmeet{{/str}}</a>
        {{/can_delete}}
        <a href="{{back_url}}" class="btn btn-secondary">{{#str}}back_to_list, mod_plugnmeet{{/str}}</a>
    </div>
</div>

<table class="generaltable mb-6">
    {{#details}}
    <tr>
        <td><strong>{{label}}</strong></td>
        <td>{{value}}</td>
    </tr>
    {{/details}}
</table>

{{#ai_summary_notice}}
<div class="mt-4">{{{ai_summary_notice}}}</div>
{{/ai_summary_notice}}

{{#is_meeting_summary}}
    <h5 class="mt-4">{{#str}}meeting_summary, mod_plugnmeet{{/str}}</h5>
    <div class="meeting-summary-content mt-4">
        {{{meeting_summary_content}}}
    </div>
{{/is_meeting_summary}}

{{#is_analytics}}
    {{> mod_plugnmeet/artifact_analytics }}
{{/is_analytics}}

{{#is_ai_session_summary}}
    {{> mod_plugnmeet/artifact_ai_session_summary }}
{{/is_ai_session_summary}}
