{{!
    @template mod_plugnmeet/artifact_analytics

    Example context (json):
    {
        "room_details": [
            {"label": "Room Duration", "value": "01:30:00"}
        ],
        "has_users": true,
        "user_headers": ["Name", "Duration"],
        "user_rows": [
            [{"value": "Jane Doe"}, {"value": "01:30:00"}]
        ]
    }
}}
<h5 class="mt-4">{{#str}}room_summary, mod_plugnmeet{{/str}}</h5>
<table class="generaltable mt-3">
    {{#room_details}}
    <tr>
        <td><strong>{{label}}</strong></td>
        <td>{{{value}}}</td>
    </tr>
    {{/room_details}}
</table>

{{#has_users}}
    <h5 class="mt-4">{{#str}}users_summary, mod_plugnmeet{{/str}}</h5>
    <div class="table-responsive mt-3">
        <table class="generaltable">
            <thead>
                <tr>
                    {{#user_headers}}
                    <th>{{.}}</th>
                    {{/user_headers}}
                </tr>
            </thead>
            <tbody>
                {{#user_rows}}
                <tr>
                    {{#.}}
                    <td>{{{value}}}</td>
                    {{/.}}
                </tr>
                {{/user_rows}}
            </tbody>
        </table>
    </div>
{{/has_users}}
